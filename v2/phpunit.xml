<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- テストは MariaDB の testing DB (docker-compose.v2.yml)。compose の DB_DATABASE を上書きする -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <!-- Laravel の env() は $_SERVER を先に読むので、compose が渡す DB_DATABASE=v2 には server でも上書きが要る -->
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="testing" force="true"/>
        <env name="DB_URL" value=""/>
        <!-- legacy:import のテストは旧スキーマのフィクスチャを legacy_testing に入れて読む -->
        <env name="LEGACY_DB_HOST" value="db" force="true"/>
        <env name="LEGACY_DB_PORT" value="3306" force="true"/>
        <env name="LEGACY_DB_DATABASE" value="legacy_testing" force="true"/>
        <env name="LEGACY_DB_USERNAME" value="v2" force="true"/>
        <env name="LEGACY_DB_PASSWORD" value="v2-local" force="true"/>
        <!-- プロセスの環境変数 (compose の environment / exec -e) より優先させる。フィクスチャは旧テーブルを DROP する -->
        <server name="LEGACY_DB_HOST" value="db" force="true"/>
        <server name="LEGACY_DB_PORT" value="3306" force="true"/>
        <server name="LEGACY_DB_DATABASE" value="legacy_testing" force="true"/>
        <server name="LEGACY_DB_USERNAME" value="v2" force="true"/>
        <server name="LEGACY_DB_PASSWORD" value="v2-local" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
